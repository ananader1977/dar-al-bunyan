DB_PATH=./data/app.db
TRUST_PROXY=true

# --- The three starting accounts (passwords: at least 10 characters, letters and numbers) ---
ADMIN1_EMAIL=ananader1@gmail.com
ADMIN1_NAME=Anas
ADMIN1_PASSWORD=
ADMIN2_EMAIL=admin2@daralbunyan.ae
ADMIN2_NAME=Administrator 2
ADMIN2_PASSWORD=
OPS_EMAIL=operations@daralbunyan.ae
OPS_NAME=Operations
OPS_PASSWORD=

# --- Email through Gmail (needs a Gmail "app password": Google Account > Security > 2-Step Verification > App passwords) ---
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=ananader1@gmail.com
SMTP_PASS=
SMTP_FROM="Dar Al Bunyan Technical Services <ananader1@gmail.com>"

# --- Google Drive for attachments (optional; without it files are kept on the server disk) ---
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REFRESH_TOKEN=
GOOGLE_DRIVE_FOLDER_ID=

# --- Online invoice payments: mock = demo checkout (default). Later: stripe + keys ---
PAYMENT_PROVIDER=mock
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# --- Optional: Excel file imported automatically on first start when the database is empty ---
IMPORT_FILE=./data/import/Expenses_Report.xlsx
